    "steps": [
      {
        "id": "ders-giris",
        "section": "karsilama",
        "type": "text",
        "title": {
          "tr": "Hoş geldiniz",
          "en": "Welcome"
        },
        "body": {
          "tr": "Öğrenciler için emzirme dersi. Videolar perdede, notlar tahtada.",
          "en": "A breastfeeding class for students. Videos on the screen, notes on the board."
        }
      },
      {
        "id": "sergi",
        "section": "karsilama",
        "type": "text",
        "title": {
          "tr": "Arka duvardaki sergi",
          "en": "The exhibition at the back"
        },
        "body": {
          "tr": "Sınıfın hazırladığı afişler arka duvarda, videolar yan duvarda; aralarda gezin.",
          "en": "The posters hang at the back, the videos on the side wall; walk over between steps."
        }
      },
      {
        "id": "ilk-saat",
        "section": "ilk-gunler",
        "type": "text",
        "title": {
          "tr": "İlk saat",
          "en": "The first hour"
        },
        "body": {
          "tr": "Doğumdan sonraki ilk saatte ten tene temas, ilk emzirmeyi kolaylaştırır.",
          "en": "Skin to skin in the first hour after birth makes the first feed easier."
        }
      },
      {
        "id": "kolostrum",
        "section": "ilk-gunler",
        "type": "text",
        "title": {
          "tr": "Kolostrum",
          "en": "Colostrum"
        },
        "body": {
          "tr": "İlk günlerin koyu sarı sütü azdır; yeni doğanın midesine yeter, bağışıklık taşır.",
          "en": "The first days' thick yellow milk is small in volume; it suits a newborn's stomach."
        }
      },
      {
        "id": "sik-emzirme",
        "section": "ilk-gunler",
        "type": "text",
        "title": {
          "tr": "Sıklık",
          "en": "How often"
        },
        "body": {
          "tr": "İlk haftalarda günde 8-12 kez emzirme, süt üretimini talebe göre ayarlar.",
          "en": "Eight to twelve feeds a day in the early weeks set supply to the baby’s demand."
        }
      },
      {
        "id": "vid-hazirlik",
        "section": "ilk-gunler",
        "type": "video",
        "title": {
          "tr": "Emzirmeye hazırlık",
          "en": "Getting ready to feed"
        },
        "src": "videos/emzirmeye-hazirlik.mp4",
        "poster": "posters/emzirmeye-hazirlik.jpg",
        "aspect": 0.5621
      },
      {
        "id": "pozisyonlar-giris",
        "section": "pozisyonlar",
        "type": "text",
        "title": {
          "tr": "Dört temel pozisyon",
          "en": "Four basic positions"
        },
        "body": {
          "tr": "Beşik, çapraz beşik, futbol topu ve yan yatarak; dördünde de sırt desteklenir.",
          "en": "Cradle, cross-cradle, football and side-lying; all four support the back."
        }
      },
      {
        "id": "vid-pozisyonlar",
        "section": "pozisyonlar",
        "type": "video",
        "title": {
          "tr": "Emzirme pozisyonları",
          "en": "Breastfeeding positions"
        },
        "src": "videos/emzirme-pozisyonlari.mp4",
        "poster": "posters/emzirme-pozisyonlari.jpg",
        "aspect": 0.5621
      },
      {
        "id": "kavrama",
        "section": "pozisyonlar",
        "type": "text",
        "title": {
          "tr": "Doğru kavrama",
          "en": "A good latch"
        },
        "body": {
          "tr": "Ağız areolanın çoğunu alır, alt dudak dışa döner, çene göğse değer.",
          "en": "The mouth takes most of the areola, the lower lip turns out, the chin touches the breast."
        }
      },
      {
        "id": "vid-kavrama",
        "section": "pozisyonlar",
        "type": "video",
        "title": {
          "tr": "Doğru kavrama",
          "en": "A good latch"
        },
        "src": "videos/dogru-kavrama.mp4",
        "poster": "posters/dogru-kavrama.jpg",
        "aspect": 0.5621
      },
      {
        "id": "gece-giris",
        "section": "gece",
        "type": "text",
        "title": {
          "tr": "Gece emzirmeleri",
          "en": "Night feeds"
        },
        "body": {
          "tr": "Prolaktin gece daha yüksektir; gece beslenmeleri süt üretimini ayakta tutar.",
          "en": "Prolactin is higher at night; night feeds are what keep supply up."
        }
      },
      {
        "id": "gece-uyku",
        "section": "gece",
        "type": "text",
        "title": {
          "tr": "Güvenli uyku",
          "en": "Safe sleep"
        },
        "body": {
          "tr": "Bebek sırtüstü, sert ve düz bir zeminde, kendi yatağında uyutulur.",
          "en": "The baby sleeps on its back, on a firm flat surface, in its own bed."
        }
      },
      {
        "id": "vid-bebek-bakimi",
        "section": "gece",
        "type": "video",
        "title": {
          "tr": "Bebek bakımı",
          "en": "Caring for the baby"
        },
        "src": "videos/bebek-bakimi.mp4",
        "poster": "posters/bebek-bakimi.jpg",
        "aspect": 0.5621
      },
      {
        "id": "sagma-giris",
        "section": "sagma",
        "type": "text",
        "title": {
          "tr": "Süt sağma",
          "en": "Expressing milk"
        },
        "body": {
          "tr": "Bebek ememediğinde, süt saklanacağında ya da meme dolduğunda süt sağılır.",
          "en": "Milk is expressed when the baby cannot feed, when it is stored, or the breast is full."
        }
      },
      {
        "id": "vid-sagma",
        "section": "sagma",
        "type": "video",
        "title": {
          "tr": "Süt sağma",
          "en": "Expressing milk"
        },
        "src": "videos/sut-sagma.mp4",
        "poster": "posters/sut-sagma.jpg",
        "aspect": 0.5621
      },
      {
        "id": "saklama",
        "section": "sagma",
        "type": "text",
        "title": {
          "tr": "Saklama süreleri",
          "en": "How long it keeps"
        },
        "body": {
          "tr": "Oda sıcaklığında üç saat, buzdolabı rafında üç gün, derin dondurucuda üç ay.",
          "en": "Three hours at room temperature, three days in the fridge, three months in the freezer."
        }
      },
      {
        "id": "sorunlar-giris",
        "section": "sorunlar",
        "type": "text",
        "title": {
          "tr": "Sık görülen sorunlar",
          "en": "What comes up"
        },
        "body": {
          "tr": "Meme ucu ağrısı, dolgunluk ve kanal tıkanması çoğunlukla kavrama düzeltilince geçer.",
          "en": "Sore nipples, engorgement and blocked ducts usually ease once the latch is corrected."
        }
      },
      {
        "id": "vid-sorunlar",
        "section": "sorunlar",
        "type": "video",
        "title": {
          "tr": "Emzirme sorunları",
          "en": "Common difficulties"
        },
        "src": "videos/emzirme-sorunlari.mp4",
        "poster": "posters/emzirme-sorunlari.jpg",
        "aspect": 0.5621
      },
      {
        "id": "sanat-giris",
        "section": "sanat",
        "type": "text",
        "title": {
          "tr": "Sanatta annelik",
          "en": "Motherhood in art"
        },
        "body": {
          "tr": "Pencere tarafındaki baskılar 1872-1894 arasında emzirmeyi resmeder.",
          "en": "The prints by the windows depict breastfeeding between 1872 and 1894."
        }
      }
