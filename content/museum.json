    "steps": [
      {
        "id": "ders-giris",
        "section": "karsilama",
        "type": "text",
        "title": {
          "tr": "Hoş geldiniz",
          "en": "Welcome"
        },
        "body": {
          "tr": "Öğrenciler için emzirme dersi. Videolar perdede, notlar tahtada.",
          "en": "A breastfeeding class for students. Videos on the screen, notes on the board."
        }
      },
      {
        "id": "ders-plani",
        "section": "karsilama",
        "type": "text",
        "title": {
          "tr": "Ders planı",
          "en": "The plan"
        },
        "body": {
          "tr": "Dört bölüm: ilk günler, pozisyonlar, gece emzirmeleri ve sanatta annelik.",
          "en": "Four sections: the first days, positions, night feeds and motherhood in art."
        }
      },
      {
        "id": "ilk-saat",
        "section": "ilk-gunler",
        "type": "text",
        "title": {
          "tr": "İlk saat",
          "en": "The first hour"
        },
        "body": {
          "tr": "Doğumdan sonraki ilk saatte ten tene temas, ilk emzirmeyi kolaylaştırır.",
          "en": "Skin to skin in the first hour after birth makes the first feed easier."
        }
      },
      {
        "id": "kolostrum",
        "section": "ilk-gunler",
        "type": "text",
        "title": {
          "tr": "Kolostrum",
          "en": "Colostrum"
        },
        "body": {
          "tr": "İlk günlerin koyu sarı sütü azdır; yeni doğanın midesine yeter, bağışıklık taşır.",
          "en": "The first days' thick yellow milk is small in volume; it suits a newborn's stomach."
        }
      },
      {
        "id": "sik-emzirme",
        "section": "ilk-gunler",
        "type": "text",
        "title": {
          "tr": "Sıklık",
          "en": "How often"
        },
        "body": {
          "tr": "İlk haftalarda günde 8-12 kez emzirme, süt üretimini talebe göre ayarlar.",
          "en": "Eight to twelve feeds a day in the early weeks sets supply to the baby’s demand."
        }
      },
      {
        "id": "vid-ilk-gunler",
        "section": "ilk-gunler",
        "type": "video",
        "title": {
          "tr": "İlk günlerde emzirme",
          "en": "Breastfeeding in the first days"
        },
        "src": "videos/spike-test-pattern.mp4",
        "poster": "posters/spike-test-pattern.jpg"
      },
      {
        "id": "pozisyonlar-giris",
        "section": "pozisyonlar",
        "type": "text",
        "title": {
          "tr": "Dört temel pozisyon",
          "en": "Four basic positions"
        },
        "body": {
          "tr": "Beşik, çapraz beşik, futbol topu ve yan yatarak; dördünde de sırt desteklenir.",
          "en": "Cradle, cross-cradle, football and side-lying; all four support the back."
        }
      },
      {
        "id": "kavrama",
        "section": "pozisyonlar",
        "type": "text",
        "title": {
          "tr": "Doğru kavrama",
          "en": "A good latch"
        },
        "body": {
          "tr": "Ağız areolanın çoğunu alır, alt dudak dışa döner, çene göğse değer.",
          "en": "The mouth takes most of the areola, the lower lip turns out, the chin touches the breast."
        }
      },
      {
        "id": "kavrama-belirti",
        "section": "pozisyonlar",
        "type": "text",
        "title": {
          "tr": "Nasıl anlaşılır",
          "en": "How to tell"
        },
        "body": {
          "tr": "Yutkunma duyulur, meme yumuşar, emzirme ağrısızdır. Ağrı kavramayı gözden geçirtir.",
          "en": "Swallowing is audible, the breast softens, feeding does not hurt."
        }
      },
      {
        "id": "vid-pozisyonlar",
        "section": "pozisyonlar",
        "type": "video",
        "title": {
          "tr": "Beşik, çapraz beşik, futbol topu ve yan yatarak",
          "en": "Cradle, cross-cradle, football and side-lying"
        },
        "src": "videos/spike-test-pattern.mp4",
        "poster": "posters/spike-test-pattern.jpg"
      },
      {
        "id": "gece-giris",
        "section": "gece",
        "type": "text",
        "title": {
          "tr": "Gece emzirmeleri",
          "en": "Night feeds"
        },
        "body": {
          "tr": "Prolaktin gece daha yüksektir; gece beslenmeleri süt üretimini ayakta tutar.",
          "en": "Prolactin is higher at night; night feeds are what keep supply up."
        }
      },
      {
        "id": "gece-uyku",
        "section": "gece",
        "type": "text",
        "title": {
          "tr": "Güvenli uyku",
          "en": "Safe sleep"
        },
        "body": {
          "tr": "Bebek sırtüstü, sert ve düz bir zeminde, kendi yatağında uyutulur.",
          "en": "The baby sleeps on its back, on a firm flat surface, in its own bed."
        }
      },
      {
        "id": "vid-gece",
        "section": "gece",
        "type": "video",
        "title": {
          "tr": "Gece beslenmesi",
          "en": "A night feed"
        },
        "src": "videos/spike-test-pattern.mp4",
        "poster": "posters/spike-test-pattern.jpg"
      },
      {
        "id": "sanat-giris",
        "section": "sanat",
        "type": "text",
        "title": {
          "tr": "Sanatta annelik",
          "en": "Motherhood in art"
        },
        "body": {
          "tr": "Duvardaki baskılar 1872-1894 arasında emzirmeyi ve bebek bakımını resmeder.",
          "en": "The prints on the wall depict breastfeeding and infant care between 1872 and 1894."
        }
      }
    ]
  }
}
