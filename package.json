{
  "name": "emzirme-muzesi",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "validate": "node --experimental-strip-types scripts/validate-content.ts",
    "media:spike": "bash scripts/make-test-video.sh",
    "media:artworks": "node scripts/fetch-artworks.ts",
    "media:polyhaven": "node scripts/fetch-polyhaven.ts",
    "test:visual": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "ktx2-encoder": "0.6.0",
    "prettier": "3.9.8",
    "sirv": "3.0.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "dependencies": {
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "@react-three/uikit": "1.0.76",
    "@react-three/xr": "6.6.30",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.186.0",
    "wouter": "3.11.0",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "overrides": {
    "three": "$three"
  }
}
